# Backend. Copy to apps/api/.env for local development.
# Never commit real keys.

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Optional. Leave empty to use deterministic local search.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional. Leave empty to read data/memes.json.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional absolute path to the meme JSON file.
# MEME_DATA_PATH=
