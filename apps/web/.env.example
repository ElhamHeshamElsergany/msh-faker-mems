# Leave empty in local development to use the Vite proxy to http://localhost:3001.
VITE_API_BASE_URL=

# Mock mode is honored only while Vite is running in development.
# Production builds ignore this flag.
VITE_USE_MOCK=false

# GitHub Actions sets this to /msh-faker-mems/ for project Pages.
# Keep "/" for local builds.
VITE_BASE_PATH=/
